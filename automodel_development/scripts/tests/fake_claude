#!/usr/bin/env bash
# Fake `claude -p` for launcher tests. FAKE_MODE: ok | limit (first $FAKE_LIMITS calls hit a usage limit) | phased
# (an attempt's first session "submits a job": STATE.md + a running countdown read by the test's job_state.sh hook).
# FAKE_ARGS: file receiving the arguments of the last call; FAKE_PROMPTS: file receiving one line per call.
p=$2
[ -n "${FAKE_ARGS:-}" ] && printf '%s\n' "$@" > "$FAKE_ARGS"
[ -n "${FAKE_PROMPTS:-}" ] && echo "$p" | tr "\n" " " >> "$FAKE_PROMPTS" && echo >> "$FAKE_PROMPTS"
if [ "${FAKE_MODE:-ok}" = limit ]; then
  c=${FAKE_COUNTER:?}; n=$(cat "$c" 2>/dev/null || echo 0); echo $((n+1)) > "$c"
  [ "$n" -lt "${FAKE_LIMITS:-0}" ] && { echo "API Error: You've hit your 5-hour limit · resets 6pm (error type rate_limit, HTTP 429)" >&2; exit 1; }
fi
a=$(echo "$p" | grep -oE 'in [^ ,]+/attempt_[0-9]+' | head -1 | cut -c4-)
if [ -n "$a" ]; then
  mkdir -p "$a"
  if [ "${FAKE_MODE:-ok}" = phased ] && [ ! -f "$a/STATE.md" ]; then echo "job submitted" > "$a/STATE.md"; echo 2 > "$a/.running"; echo submitted; exit 0; fi
  echo '{"status":"ok"}' > "$a/result.json"
else
  d=$(echo "$p" | grep -oE 'attempts in [^ ]+ are' | cut -d' ' -f3); echo summary > "$d/summary.md"
fi
echo done; exit 0
