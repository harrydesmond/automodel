#!/usr/bin/env bash
# Fake `codex exec` for launcher tests. Behaviour from $FAKE_MODE: ok | empty | badmodel | flaky | hang.
p="${@: -1}"; reply=""; prev=""
for x in "$@"; do [ "$prev" = "-o" ] && reply=$x; prev=$x; done
a=$(echo "$p" | grep -oE 'in [^ ,]+/attempt_[0-9]+' | head -1 | cut -c4-)
case ${FAKE_MODE:-ok} in
  badmodel) echo "error: model 'nope' not found" >&2; exit 1 ;;
  hang) sleep 300; exit 0 ;;
  stubborn) bash -c 'trap "" TERM; while :; do date +%s%N > "$HB"; sleep 0.2; done' & sleep 300; exit 0 ;;
  flaky) c=${FAKE_COUNTER:?}; n=$(cat "$c" 2>/dev/null || echo 0); echo $((n+1)) > "$c"
         [ "$n" -eq 0 ] && { echo "transient network error" >&2; exit 1; } ;;
esac
if [ -n "$a" ]; then
  mkdir -p "$a"
  if [ "${FAKE_MODE:-ok}" = empty ]; then : > "$a/evaluation.md"; else echo '{"status":"ok"}' > "$a/result.json"; echo ok > "$a/evaluation.md"; fi
else
  d=$(echo "$p" | grep -oE 'attempts in [^ ]+ are' | cut -d' ' -f3); [ "${FAKE_MODE:-ok}" = empty ] && : > "$d/summary.md" || echo summary > "$d/summary.md"
fi
[ -n "$reply" ] && echo done > "$reply"; exit 0
